PORT=8787
# Bind address. Loopback by default so a local run is never exposed; the
# container image overrides this to 0.0.0.0 because a published port cannot
# reach a loopback bind inside the container.
BOT_BUFFET_HOST=127.0.0.1
BOT_BUFFET_DATA_DIR=.data
BOT_BUFFET_OFFLINE=false
BOT_BUFFET_AUTH_MODE=development
BOT_BUFFET_ALLOWED_ORIGINS=http://localhost:8787
BOT_BUFFET_MASTER_KEY=replace-with-a-32-byte-secret
BOT_BUFFET_BACKUP_KEY=
BOT_BUFFET_OIDC_ISSUER=
BOT_BUFFET_OIDC_AUDIENCE=
BOT_BUFFET_OIDC_JWKS_URI=
BOT_BUFFET_OIDC_JWKS_JSON=
BOT_BUFFET_OIDC_NONCE=
BOT_BUFFET_BOOTSTRAP_TOKEN=
# Public environment-backed providers require exact operator-approved hosts;
# production additionally requires exact variable names. Never include
# Bot Buffet control-plane secrets in these lists.
BOT_BUFFET_PROVIDER_ENDPOINT_ALLOWLIST=api.openai.com,api.anthropic.com
BOT_BUFFET_PROVIDER_ENV_ALLOWLIST=OPENAI_API_KEY,ANTHROPIC_API_KEY
# Agent-generated code always runs in Docker; there is no host-process fallback.
# Development may use a tag. Production REQUIRES a digest-pinned reference
# (name@sha256:<64 hex>) and refuses to start without one: a mutable tag means
# the environment containing agent-generated code can change underneath you.
BOT_BUFFET_SANDBOX_MODE=docker
# Resolve a digest with: docker buildx imagetools inspect node:22-alpine
BOT_BUFFET_SANDBOX_IMAGE=node:22-alpine
