{
  "name": "bot-buffet",
  "version": "0.2.0",
  "private": true,
  "description": "Samuel Abraham's Bot Buffet: a model-agnostic, user-controlled AI agent control plane.",
  "author": "Samuel Abraham",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "preflight": "node scripts/preflight.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "audit": "npm audit --audit-level=high",
    "security:scan": "node scripts/security-scan.mjs",
    "brand:scan": "node scripts/brand-scan.mjs",
    "sbom": "node scripts/sbom.mjs",
    "provenance": "node scripts/provenance.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "smoke": "node scripts/smoke.mjs",
    "restore:drill": "node scripts/restore-drill.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run brand:scan"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "4.12.1",
    "eslint": "^9.17.0",
    "playwright": "1.62.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
